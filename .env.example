# Copy into backend/.env and frontend/.env.local as needed.
# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ekofi?schema=public"

# Backend (backend/.env)
JWT_SECRET="change-this-to-a-long-random-secret"
CARD_TOKEN_PEPPER="change-this-card-token-pepper"
PORT=3001
FRONTEND_ORIGIN="http://localhost:3000"
PIN_MAX_ATTEMPTS=5
PIN_LOCK_MINUTES=15

# Frontend (frontend/.env.local)
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
